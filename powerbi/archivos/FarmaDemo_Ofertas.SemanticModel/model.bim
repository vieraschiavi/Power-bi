                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Fecha\", type datetime}, {\"Id cliente\", Int64.Type}, {\"Id producto\", Int64.Type}, {\"Id filial\", Int64.Type}, {\"Id depósito\", Int64.Type}, {\"Id transportista\", Int64.Type}, {\"Id tipo oferta\", Int64.Type}, {\"Tipo documento\", type text}, {\"Unidades\", Int64.Type}, {\"Importe USD\", type number}, {\"Costo USD\", type number}, {\"Importe moneda local\", type number}, {\"Líneas\", Int64.Type}, {\"Líneas OTIF\", Int64.Type}, {\"Líneas completas\", Int64.Type}, {\"Lead time x línea\", type number}, {\"Unidades devueltas\", Int64.Type}, {\"Importe devuelto USD\", type number}, {\"Líneas devueltas\", Int64.Type}, {\"Líneas en revisión\", Int64.Type}, {\"Días a vencer x línea\", type number}, {\"Signo\", Int64.Type}})",
