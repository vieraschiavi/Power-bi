              "type": "m",
              "expression": [
                "let",
                "    FuenteSQL = () => Sql.Database(ServidorSQL, BaseSQL){[Schema=\"star\", Item=\"v_dim_filial\"]}[Data],",
                "    FuenteParquet = () =>",
