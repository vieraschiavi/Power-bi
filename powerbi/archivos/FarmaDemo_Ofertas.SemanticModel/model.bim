        ],
        "partitions": [
          {
            "name": "v_dim_cliente",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FuenteSQL = () => Sql.Database(ServidorSQL, BaseSQL){[Schema=\"star\", Item=\"v_dim_cliente\"]}[Data],",
                "    FuenteParquet = () =>",
                "        let",
                "            Crudo = Parquet.Document(File.Contents(RutaDatos & \"\\dim_cliente.parquet\")),",
                "            Satelite = Parquet.Document(File.Contents(RutaDatos & \"\\dim_representante.parquet\")),",
                "            Unido = Table.NestedJoin(Crudo, {\"id_representante\"}, Satelite, {\"id_representante\"}, \"_sat\", JoinKind.LeftOuter),",
                "            Expandido = Table.ExpandTableColumn(Unido, \"_sat\", {\"nombre_rep\", \"supervisor\", \"linea_promocion\"}, {\"Representante\", \"Supervisor\", \"Línea de promoción\"}),",
                "            Renombrado = Table.RenameColumns(Expandido, {{\"id_cliente\", \"Id cliente\"}, {\"id_filial\", \"Id filial cliente\"}, {\"cod_cliente\", \"Código cliente\"}, {\"razon_social\", \"Cliente\"}, {\"canal\", \"Canal\"}, {\"segmento\", \"Segmento\"}, {\"antiguedad_meses\", \"Antigüedad (meses)\"}})",
                "        in",
                "            Renombrado,",
                "    Origen = if OrigenDatos = \"SQL Server\" then FuenteSQL() else FuenteParquet(),",
                "    Seleccionado = Table.SelectColumns(Origen, {\"Id cliente\", \"Id filial cliente\", \"Código cliente\", \"Cliente\", \"Canal\", \"Segmento\", \"Antigüedad (meses)\", \"Representante\", \"Supervisor\", \"Línea de promoción\"}),",
                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Id cliente\", Int64.Type}, {\"Id filial cliente\", Int64.Type}, {\"Código cliente\", type text}, {\"Cliente\", type text}, {\"Canal\", type text}, {\"Segmento\", type text}, {\"Antigüedad (meses)\", Int64.Type}, {\"Representante\", type text}, {\"Supervisor\", type text}, {\"Línea de promoción\", type text}})",
                "in",
                "    Tipado"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Estructura comercial",
            "levels": [
              {
                "name": "Canal",
                "ordinal": 0,
                "column": "Canal"
              },
              {
                "name": "Segmento",
                "ordinal": 1,
                "column": "Segmento"
              },
              {
                "name": "Cliente",
                "ordinal": 2,
                "column": "Cliente"
              }
            ]
          }
        ]
      },
