            "name": "v_fact_recomendaciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FuenteSQL = () => Sql.Database(ServidorSQL, BaseSQL){[Schema=\"star\", Item=\"v_fact_recomendaciones\"]}[Data],",
                "    FuenteParquet = () =>",
                "        let",
                "            Crudo = Parquet.Document(File.Contents(RutaDatos & \"\\fact_recomendaciones.parquet\")),",
                "            Derivada0 = Table.AddColumn(Crudo, \"Confianza de la recomendación\", each if [en_borde_de_soporte] = 1 then \"Requiere test controlado\" else \"Dentro de evidencia histórica\", type text),",
                "            Renombrado = Table.RenameColumns(Derivada0, {{\"mes_objetivo\", \"Mes objetivo\"}, {\"id_filial\", \"Id filial\"}, {\"id_producto\", \"Id producto\"}, {\"canal\", \"Canal recomendado\"}, {\"segmento\", \"Segmento recomendado\"}, {\"rank_segmento\", \"Ranking en el segmento\"}, {\"sku\", \"SKU recomendado\"}, {\"marca\", \"Marca recomendada\"}, {\"descuento_pct\", \"Descuento recomendado\"}, {\"precio_neto\", \"Precio neto recomendado\"}, {\"margen_unitario\", \"Margen unitario USD\"}, {\"elasticidad\", \"Elasticidad estimada\"}, {\"nivel_estimacion\", \"Nivel de estimación\"}, {\"indice_estacional\", \"Índice estacional\"}, {\"aporte_margen_pct\", \"Aporte al margen de la filial\"}, {\"dias_cobertura\", \"Días de cobertura\"}, {\"unidades_por_vencer\", \"Unidades por vencer\"}, {\"demanda_esperada\", \"Demanda esperada\"}, {\"prob_aceptacion\", \"Probabilidad de aceptación\"}, {\"riesgo_devolucion\", \"Riesgo de devolución\"}, {\"margen_esperado_usd\", \"Margen esperado USD\"}, {\"valor_rescate_usd\", \"Valor de stock rescatado USD\"}, {\"ganancia_vs_sin_oferta_usd\", \"Ganancia vs no ofertar USD\"}, {\"justificativo\", \"Justificativo\"}})",
                "        in",
                "            Renombrado,",
                "    Origen = if OrigenDatos = \"SQL Server\" then FuenteSQL() else FuenteParquet(),",
                "    Seleccionado = Table.SelectColumns(Origen, {\"Mes objetivo\", \"Id filial\", \"Id producto\", \"Canal recomendado\", \"Segmento recomendado\", \"Ranking en el segmento\", \"SKU recomendado\", \"Marca recomendada\", \"Descuento recomendado\", \"Precio neto recomendado\", \"Margen unitario USD\", \"Elasticidad estimada\", \"Nivel de estimación\", \"Índice estacional\", \"Aporte al margen de la filial\", \"Días de cobertura\", \"Unidades por vencer\", \"Demanda esperada\", \"Probabilidad de aceptación\", \"Riesgo de devolución\", \"Margen esperado USD\", \"Valor de stock rescatado USD\", \"Ganancia vs no ofertar USD\", \"Justificativo\", \"Confianza de la recomendación\"}),",
                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Mes objetivo\", type text}, {\"Id filial\", Int64.Type}, {\"Id producto\", Int64.Type}, {\"Canal recomendado\", type text}, {\"Segmento recomendado\", type text}, {\"Ranking en el segmento\", Int64.Type}, {\"SKU recomendado\", type text}, {\"Marca recomendada\", type text}, {\"Descuento recomendado\", type number}, {\"Precio neto recomendado\", type number}, {\"Margen unitario USD\", type number}, {\"Elasticidad estimada\", type number}, {\"Nivel de estimación\", type text}, {\"Índice estacional\", type number}, {\"Aporte al margen de la filial\", type number}, {\"Días de cobertura\", type number}, {\"Unidades por vencer\", type number}, {\"Demanda esperada\", type number}, {\"Probabilidad de aceptación\", type number}, {\"Riesgo de devolución\", type number}, {\"Margen esperado USD\", type number}, {\"Valor de stock rescatado USD\", type number}, {\"Ganancia vs no ofertar USD\", type number}, {\"Justificativo\", type text}, {\"Confianza de la recomendación\", type text}})",
                "in",
                "    Tipado"
              ]
            }
          }
        ]
