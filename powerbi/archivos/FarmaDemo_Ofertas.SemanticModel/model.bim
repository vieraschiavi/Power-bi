          }
        ],
        "partitions": [
          {
            "name": "v_dim_calendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FuenteSQL = () => Sql.Database(ServidorSQL, BaseSQL){[Schema=\"star\", Item=\"v_dim_calendario\"]}[Data],",
                "    FuenteParquet = () =>",
                "        let",
                "            Crudo = Parquet.Document(File.Contents(RutaDatos & \"\\dim_calendario.parquet\")),",
                "            Renombrado = Table.RenameColumns(Crudo, {{\"fecha\", \"Fecha\"}, {\"anio\", \"Año\"}, {\"mes_nro\", \"Mes N°\"}, {\"mes_nombre\", \"Mes\"}, {\"anio_mes\", \"Año-Mes\"}, {\"anio_mes_orden\", \"Año-Mes orden\"}, {\"trimestre\", \"Trimestre\"}, {\"anio_trimestre\", \"Año-Trimestre\"}, {\"es_habil\", \"Es día hábil\"}, {\"es_pasado\", \"Es pasado\"}, {\"temporada_respiratoria\", \"Temporada respiratoria\"}})",
                "        in",
                "            Renombrado,",
                "    Origen = if OrigenDatos = \"SQL Server\" then FuenteSQL() else FuenteParquet(),",
                "    Seleccionado = Table.SelectColumns(Origen, {\"Fecha\", \"Año\", \"Mes N°\", \"Mes\", \"Año-Mes\", \"Año-Mes orden\", \"Trimestre\", \"Año-Trimestre\", \"Es día hábil\", \"Es pasado\", \"Temporada respiratoria\"}),",
                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Fecha\", type datetime}, {\"Año\", Int64.Type}, {\"Mes N°\", Int64.Type}, {\"Mes\", type text}, {\"Año-Mes\", type text}, {\"Año-Mes orden\", Int64.Type}, {\"Trimestre\", type text}, {\"Año-Trimestre\", type text}, {\"Es día hábil\", Int64.Type}, {\"Es pasado\", Int64.Type}, {\"Temporada respiratoria\", Int64.Type}})",
                "in",
                "    Tipado"
              ]
            }
          }
        ],
        "dataCategory": "Time",
        "hierarchies": [
          {
            "name": "Calendario",
            "levels": [
              {
                "name": "Año",
                "ordinal": 0,
                "column": "Año"
              },
              {
                "name": "Trimestre",
                "ordinal": 1,
                "column": "Trimestre"
              },
              {
                "name": "Mes",
                "ordinal": 2,
                "column": "Mes"
              }
            ]
          }
        ]
      },
