        ],
        "partitions": [
          {
            "name": "v_dim_producto",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FuenteSQL = () => Sql.Database(ServidorSQL, BaseSQL){[Schema=\"star\", Item=\"v_dim_producto\"]}[Data],",
                "    FuenteParquet = () =>",
                "        let",
                "            Crudo = Parquet.Document(File.Contents(RutaDatos & \"\\dim_producto.parquet\")),",
                "            Derivada0 = Table.AddColumn(Crudo, \"Condición de conservación\", each if [cadena_frio] then \"Cadena de frío\" else \"Temperatura ambiente\", type text),",
                "            Derivada1 = Table.AddColumn(Derivada0, \"Origen del costo\", each if [costo_imputado] = 1 then \"Costo imputado\" else \"Costo real\", type text),",
                "            Renombrado = Table.RenameColumns(Derivada1, {{\"id_producto\", \"Id producto\"}, {\"sku\", \"SKU\"}, {\"marca\", \"Marca\"}, {\"atc1\", \"ATC1\"}, {\"atc1_desc\", \"Clase terapéutica\"}, {\"atc3\", \"ATC3\"}, {\"forma_farmaceutica\", \"Forma farmacéutica\"}, {\"presentacion\", \"Presentación\"}, {\"tipo_venta\", \"Tipo de venta\"}, {\"ciclo_vida\", \"Ciclo de vida\"}, {\"vida_util_meses\", \"Vida útil (meses)\"}, {\"precio_lista_usd\", \"Precio de lista USD\"}, {\"costo_std_usd\", \"Costo estándar USD\"}, {\"margen_std_pct\", \"Margen estándar %\"}})",
                "        in",
                "            Renombrado,",
                "    Origen = if OrigenDatos = \"SQL Server\" then FuenteSQL() else FuenteParquet(),",
                "    Seleccionado = Table.SelectColumns(Origen, {\"Id producto\", \"SKU\", \"Marca\", \"ATC1\", \"Clase terapéutica\", \"ATC3\", \"Forma farmacéutica\", \"Presentación\", \"Tipo de venta\", \"Ciclo de vida\", \"Vida útil (meses)\", \"Precio de lista USD\", \"Costo estándar USD\", \"Margen estándar %\", \"Condición de conservación\", \"Origen del costo\"}),",
                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Id producto\", Int64.Type}, {\"SKU\", type text}, {\"Marca\", type text}, {\"ATC1\", type text}, {\"Clase terapéutica\", type text}, {\"ATC3\", type text}, {\"Forma farmacéutica\", type text}, {\"Presentación\", type text}, {\"Tipo de venta\", type text}, {\"Ciclo de vida\", type text}, {\"Vida útil (meses)\", Int64.Type}, {\"Precio de lista USD\", type number}, {\"Costo estándar USD\", type number}, {\"Margen estándar %\", type number}, {\"Condición de conservación\", type text}, {\"Origen del costo\", type text}})",
                "in",
                "    Tipado"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Producto",
