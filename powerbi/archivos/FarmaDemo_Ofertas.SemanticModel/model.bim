{
  "name": "FarmaDemo_Ofertas",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-ES",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-ES",
    "expressions": [
      {
        "name": "OrigenDatos",
        "kind": "m",
        "description": "De dónde lee el modelo. 'Parquet' usa los archivos locales que genera el pipeline; 'SQL Server' se conecta a las vistas star.v_* del data warehouse. Las 117 medidas funcionan igual con los dos.",
        "expression": [
          "\"Parquet\"",
          "    meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true, AllowedValues = {\"Parquet\", \"SQL Server\"}]"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "RutaDatos",
        "kind": "m",
        "description": "Solo para OrigenDatos = 'Parquet'. Carpeta con los .parquet del modelo estrella (la que genera `python src/run_all.py`). Ruta absoluta, sin barra final.",
        "expression": [
          "\"C:\\FarmaDemo\\data\\star\"",
          "    meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "ServidorSQL",
        "kind": "m",
        "description": "Solo para OrigenDatos = 'SQL Server'. Instancia donde se desplegaron los scripts de sql/.",
        "expression": [
          "\"localhost\"",
          "    meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "BaseSQL",
        "kind": "m",
        "description": "Solo para OrigenDatos = 'SQL Server'. Base de datos que contiene el esquema star.",
        "expression": [
          "\"FarmaDemoBI\"",
          "    meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      }
    ],
    "tables": [
