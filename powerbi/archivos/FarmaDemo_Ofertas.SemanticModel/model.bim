                "        let",
                "            Crudo = Parquet.Document(File.Contents(RutaDatos & \"\\fact_estado_datos.parquet\")),",
                "            Renombrado = Table.RenameColumns(Crudo, {{\"ultimo_dato\", \"Último dato\"}, {\"controles_criticos\", \"Controles críticos\"}, {\"controles_alerta\", \"Controles en alerta\"}, {\"controles_ok\", \"Controles OK\"}, {\"ultima_validacion\", \"Última validación\"}})",
                "        in",
                "            Renombrado,",
                "    Origen = if OrigenDatos = \"SQL Server\" then FuenteSQL() else FuenteParquet(),",
                "    Seleccionado = Table.SelectColumns(Origen, {\"Último dato\", \"Controles críticos\", \"Controles en alerta\", \"Controles OK\", \"Última validación\"}),",
                "    Tipado = Table.TransformColumnTypes(Seleccionado, {{\"Último dato\", type datetime}, {\"Controles críticos\", Int64.Type}, {\"Controles en alerta\", Int64.Type}, {\"Controles OK\", Int64.Type}, {\"Última validación\", type datetime}})",
                "in",
                "    Tipado"
              ]
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "_",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "_",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table({\"_\"}, {{\"\"}})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas Brutas USD",
            "expression": [
              "CALCULATE (",
              "    SUM ( v_fact_ventas[Importe USD] ),",
              "    v_fact_ventas[Tipo documento] = \"FC\"",
              ")"
            ],
            "formatString": "#,0",
            "description": "========================================================================= FARMA DEMO — Biblioteca DAX · 00 · MEDIDAS BASE  Estas medidas las comparten los tres tableros (VAR, Ofertas, Logística). Viven en una tabla vacía llamada `_Medidas` para que el panel de campos muestre el modelo separado de los cálculos.  Dos criterios que se aplican en TODA la biblioteca:  1. Ningún ratio se materializa en SQL. Se calcula acá, con DIVIDE, en el contexto de filtro del visual. Un ratio precalculado se promedia mal en cuanto el usuario cambia de nivel de agregación.  2. Toda división usa DIVIDE(), nunca \"/\". DIVIDE devuelve BLANK ante denominador cero en vez de un error que rompe el visual entero.  Nomenclatura: nombre de negocio, sin prefijos técnicos, con la unidad explícita entre paréntesis cuando puede haber ambigüedad. ========================================================================= ------------------------------------------------------------------------- VENTAS ------------------------------------------------------------------------- Ventas brutas: toda la facturación, sin restar notas de crédito.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Ventas Netas USD",
            "expression": [
              "SUMX ( v_fact_ventas, v_fact_ventas[Importe USD] * v_fact_ventas[Signo] )"
            ],
            "formatString": "#,0",
            "description": "Ventas netas: LA cifra oficial de la compañía. El signo viene como columna del modelo (+1 factura / -1 nota de crédito), así que una sola SUMX resuelve netas sin repetir la regla en cada medida. Si mañana cambia el criterio de qué resta, se cambia en el ETL y todas las medidas quedan consistentes automáticamente.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Unidades",
            "expression": [
              "SUMX ( v_fact_ventas, v_fact_ventas[Unidades] * v_fact_ventas[Signo] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Costo USD",
            "expression": [
              "SUMX ( v_fact_ventas, v_fact_ventas[Costo USD] * v_fact_ventas[Signo] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Margen Bruto USD",
            "expression": [
              "[Ventas Netas USD] - [Costo USD]"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Margen Bruto %",
            "expression": [
              "DIVIDE ( [Margen Bruto USD], [Ventas Netas USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Precio Promedio USD",
            "expression": [
              "DIVIDE ( [Ventas Netas USD], [Unidades] )"
            ],
            "formatString": "#,0",
            "description": "Precio promedio REALIZADO, no el de lista. Es un promedio ponderado por volumen: dividir la venta por las unidades. Promediar la columna de precio daría el precio \"promedio de las líneas\", que no significa nada.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Descuento Efectivo %",
            "expression": [
              "VAR VentaALista =",
              "    SUMX (",
              "        v_fact_ventas,",
              "        v_fact_ventas[Unidades] * v_fact_ventas[Signo]",
              "            * RELATED ( v_dim_producto[Precio de lista USD] )",
              "    )",
              "RETURN",
              "    DIVIDE ( VentaALista - [Ventas Netas USD], VentaALista )"
            ],
            "formatString": "0.0%",
            "description": "Descuento efectivo: cuánto se resignó respecto del precio de lista. Es la métrica que el área comercial mira antes que cualquier otra.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Ventas Netas USD AA",
            "expression": [
              "CALCULATE ( [Ventas Netas USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- INTELIGENCIA DE TIEMPO Todo apoyado en v_dim_calendario, marcada como tabla de fechas. Nunca sobre la fecha de la tabla de hechos: ahí las funciones de time intelligence dan resultados silenciosamente incorrectos. -------------------------------------------------------------------------",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Var % vs AA",
            "expression": [
              "DIVIDE ( [Ventas Netas USD] - [Ventas Netas USD AA], [Ventas Netas USD AA] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Var USD vs AA",
            "expression": [
              "[Ventas Netas USD] - [Ventas Netas USD AA]"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Ventas Netas USD YTD",
            "expression": [
              "TOTALYTD ( [Ventas Netas USD], v_dim_calendario[Fecha] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "MAT Ventas USD",
            "expression": [
              "CALCULATE (",
              "    [Ventas Netas USD],",
              "    DATESINPERIOD (",
              "        v_dim_calendario[Fecha],",
              "        MAX ( v_dim_calendario[Fecha] ),",
              "        -12,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "description": "MAT — Moving Annual Total. Es EL estándar de reporte de la industria farmacéutica: total móvil de 12 meses, que neutraliza la estacionalidad. Sin MAT, una caída de julio en respiratorios parece un problema comercial cuando en realidad es que julio del año pasado también fue alto.",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "MAT Ventas USD AA",
            "expression": [
              "CALCULATE ( [MAT Ventas USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "MAT Var %",
            "expression": [
              "DIVIDE ( [MAT Ventas USD] - [MAT Ventas USD AA], [MAT Ventas USD AA] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Ventas Netas USD MA3",
            "expression": [
              "AVERAGEX (",
              "    DATESINPERIOD ( v_dim_calendario[Fecha], MAX ( v_dim_calendario[Fecha] ), -3, MONTH ),",
              "    CALCULATE ( [Ventas Netas USD] )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Último Dato",
            "expression": [
              "CALCULATE ( MAX ( v_fact_ventas[Fecha] ), REMOVEFILTERS () )"
            ],
            "formatString": "#,0.00",
            "description": "------------------------------------------------------------------------- GOBIERNO DEL DATO El estado de la información va VISIBLE en el tablero, no escondido. Cuando el negocio ve el estado del dato, empieza a cuidarlo. -------------------------------------------------------------------------",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Días de Atraso",
            "expression": [
              "DATEDIFF ( [Último Dato], TODAY (), DAY )"
            ],
            "formatString": "#,0.0",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Estado de Vigencia",
            "expression": [
              "VAR Atraso = [Días de Atraso]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        Atraso <= 5,  \"🟢 Al día\",",
              "        Atraso <= 10, \"🟡 Con atraso\",",
              "        \"🔴 Fuera de SLA\"",
              "    )"
            ],
            "description": "Semáforo de vigencia con el SLA de carga acordado (5 días hábiles).",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Ventas en Revisión %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Ventas Netas USD], v_fact_ventas[Líneas en revisión] > 0 ),",
              "    [Ventas Netas USD]",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Porcentaje de la venta que descansa sobre líneas marcadas para revisión. No es lo mismo que 300 líneas estén marcadas a que esas 300 líneas sean el 40% de la facturación del mes.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Encabezado de Confianza",
            "expression": [
              "VAR Critico = MAX ( v_estado_datos[Controles críticos] )",
              "VAR Alerta  = MAX ( v_estado_datos[Controles en alerta] )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        Critico > 0, \"🔴 \" & Critico & \" control(es) crítico(s) — cifra no publicable\",",
              "        Alerta > 0,  \"🟡 \" & Alerta & \" alerta(s) de calidad — revisar antes de decidir\",",
              "        \"🟢 Validado contra origen\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Título del Contexto",
            "expression": [
              "VAR Filial   = SELECTEDVALUE ( v_dim_filial[País], \"todas las filiales\" )",
              "VAR Periodo  = SELECTEDVALUE ( v_dim_calendario[Año-Mes], \"el período seleccionado\" )",
              "VAR Clase    = SELECTEDVALUE ( v_dim_producto[Clase terapéutica], \"todas las clases\" )",
              "RETURN",
              "    \"Ventas de \" & Clase & \" en \" & Filial & \" · \" & Periodo"
            ],
            "description": "------------------------------------------------------------------------- UTILIDADES DE PRESENTACIÓN ------------------------------------------------------------------------- Título dinámico: el usuario siempre sabe qué está mirando, aunque haya llegado por drill-through desde otra página.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Objetivo USD",
            "expression": [
              "SUM ( v_fact_objetivos[Objetivo USD] )"
            ],
            "formatString": "#,0",
            "description": "========================================================================= FARMA DEMO — Biblioteca DAX · 01 · TABLERO VAR (Ventas · Análisis · Rentabilidad)  Pregunta que responde el tablero: \"¿Cómo venimos contra objetivo, contra el año pasado y contra el mercado, y de dónde viene exactamente la diferencia?\"  La pieza que separa este tablero de un reporte de ventas común es el puente Precio–Volumen–Mix: no alcanza con decir que las ventas cayeron 8%; hay que decir cuánto de esa caída es precio, cuánto volumen y cuánto cambio de mezcla de productos. Son tres problemas distintos con tres dueños distintos. ========================================================================= ------------------------------------------------------------------------- OBJETIVO Y CUMPLIMIENTO -------------------------------------------------------------------------",
            "displayFolder": "04 · Objetivo"
          },
          {
            "name": "Cumplimiento %",
            "expression": [
              "DIVIDE ( [Ventas Netas USD], [Objetivo USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "04 · Objetivo"
          },
          {
            "name": "Gap vs Objetivo USD",
            "expression": [
              "[Ventas Netas USD] - [Objetivo USD]"
            ],
            "formatString": "#,0",
            "displayFolder": "04 · Objetivo"
          },
          {
            "name": "Cumplimiento Proyectado %",
            "expression": [
              "VAR HabilesTranscurridos =",
              "    CALCULATE (",
              "        COUNTROWS ( v_dim_calendario ),",
              "        v_dim_calendario[Es día hábil] = TRUE (),",
              "        v_dim_calendario[Fecha] <= [Último Dato]",
              "    )",
              "VAR HabilesDelMes =",
              "    CALCULATE (",
              "        COUNTROWS ( v_dim_calendario ),",
              "        v_dim_calendario[Es día hábil] = TRUE (),",
              "        REMOVEFILTERS ( v_dim_calendario[Fecha] ),",
              "        VALUES ( v_dim_calendario[Año-Mes] )",
              "    )",
              "VAR Proyeccion = DIVIDE ( [Ventas Netas USD] * HabilesDelMes, HabilesTranscurridos )",
              "RETURN",
              "    DIVIDE ( Proyeccion, [Objetivo USD] )"
            ],
            "formatString": "0.0%",
            "description": "Cumplimiento proyectado a fin de mes, usando el ritmo de días hábiles transcurridos. Sirve para actuar DURANTE el mes, no para lamentarse después: es la diferencia entre un tablero de gestión y uno de autopsia.",
            "displayFolder": "04 · Objetivo"
          },
          {
            "name": "Semáforo de Cumplimiento",
            "expression": [
              "VAR C = [Cumplimiento %]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( C ), BLANK (),",
              "        C >= 1,    \"🟢\",",
              "        C >= 0.90, \"🟡\",",
              "        \"🔴\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Sell-out USD",
            "expression": [
              "SUM ( v_fact_sellout[Importe sell-out USD] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- SELL-IN vs SELL-OUT — el análisis que define a un analista de farma  Sell-in  = lo que el laboratorio le factura al distribuidor Sell-out = lo que la farmacia le vende al paciente (demanda real)  Si el sell-in crece y el sell-out no, no hay más demanda: hay stock acumulándose en el canal, y esa venta va a volver como devolución o como caída del mes siguiente. -------------------------------------------------------------------------",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Sell-out Unidades",
            "expression": [
              "SUM ( v_fact_sellout[Unidades sell-out] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Brecha Sell-in vs Sell-out %",
            "expression": [
              "DIVIDE ( [Unidades] - [Sell-out Unidades], [Sell-out Unidades] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Alerta de Carga de Canal",
            "expression": [
              "VAR Brecha = [Brecha Sell-in vs Sell-out %]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Brecha ), BLANK (),",
              "        Brecha > 0.25, \"🔴 Carga de canal: el sell-in supera la demanda real en más de 25%\",",
              "        Brecha > 0.12, \"🟡 Sell-in por encima del sell-out — vigilar stock del canal\",",
              "        Brecha < -0.15, \"🔵 El canal está desabastecido: se vende más de lo que se le entrega\",",
              "        \"🟢 Sell-in alineado con la demanda\"",
              "    )"
            ],
            "description": "Alerta de carga de canal: se dispara cuando el sell-in corre muy por encima del sell-out de forma sostenida.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Mercado USD",
            "expression": [
              "SUM ( v_fact_sellout[Importe mercado USD] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- MARKET SHARE — la métrica reina, y la más fácil de calcular mal  Share es un cociente. Puede caer porque vendí menos O porque el mercado creció y yo crecí menos. Son dos historias distintas, con dos acciones distintas. Por eso siempre se muestra el share JUNTO a la venta absoluta. -------------------------------------------------------------------------",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Mercado Unidades",
            "expression": [
              "SUM ( v_fact_sellout[Unidades mercado] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Market Share Valores %",
            "expression": [
              "DIVIDE ( [Sell-out USD], [Mercado USD] )"
            ],
            "formatString": "0.0%",
            "description": "Share en valores y en unidades: NUNCA uno solo. Se puede ganar share en unidades y perderlo en valores — eso significa que se está creciendo a costa de precio, que es una noticia mala disfrazada de buena.",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Market Share Unidades %",
            "expression": [
              "DIVIDE ( [Sell-out Unidades], [Mercado Unidades] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Market Share Valores % AA",
            "expression": [
              "CALCULATE ( [Market Share Valores %], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Var Share pp",
            "expression": [
              "( [Market Share Valores %] - [Market Share Valores % AA] ) * 100"
            ],
            "formatString": "#,0.0",
            "description": "La variación de un porcentaje se expresa en PUNTOS PORCENTUALES, no en porcentaje. \"El share cayó 10%\" es ambiguo; \"cayó 2 pp\" no lo es.",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Origen de la Variación de Share",
            "expression": [
              "VAR MiVar      = DIVIDE ( [Sell-out USD], CALCULATE ( [Sell-out USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) ) ) - 1",
              "VAR MercadoVar = DIVIDE ( [Mercado USD], CALCULATE ( [Mercado USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) ) ) - 1",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( MiVar ) || ISBLANK ( MercadoVar ), BLANK (),",
              "        MiVar < 0 && MercadoVar < 0,",
              "            \"Cae el mercado y caemos con él (\" & FORMAT ( MercadoVar, \"0.0%\" ) & \" el mercado)\",",
              "        MiVar < 0 && MercadoVar >= 0,",
              "            \"Problema propio: el mercado creció \" & FORMAT ( MercadoVar, \"0.0%\" ) & \" y nosotros \" & FORMAT ( MiVar, \"0.0%\" ),",
              "        MiVar >= 0 && MercadoVar > MiVar,",
              "            \"Crecemos menos que el mercado (\" & FORMAT ( MiVar, \"0.0%\" ) & \" vs \" & FORMAT ( MercadoVar, \"0.0%\" ) & \")\",",
              "        \"Ganamos share: crecemos \" & FORMAT ( MiVar, \"0.0%\" ) & \" contra un mercado de \" & FORMAT ( MercadoVar, \"0.0%\" )",
              "    )"
            ],
            "description": "Descomposición de la variación de share: ¿fue porque yo caí o porque el mercado creció? Es la primera pregunta que hay que responder y casi nunca está en el tablero.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Efecto Volumen USD",
            "expression": [
              "VAR PrecioAA   = CALCULATE ( [Precio Promedio USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )",
              "VAR UnidadesAA = CALCULATE ( [Unidades], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )",
              "RETURN",
              "    ( [Unidades] - UnidadesAA ) * PrecioAA"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- PUENTE PRECIO – VOLUMEN – MIX  Descompone la variación de ventas vs año anterior en tres efectos:  Volumen : vendí más o menos unidades, a la mezcla y precio del año pasado Precio  : las mismas unidades, a distinto precio Mix     : cambió la composición hacia productos más caros o más baratos  La suma de los tres reconstruye exactamente la variación total. Ese cierre es lo que hace que el comité confíe en la descomposición: si no cierra, es un modelo de opinión, no de datos. -------------------------------------------------------------------------",
            "displayFolder": "03 · Puente Precio-Volumen-Mix"
          },
          {
            "name": "Efecto Precio USD",
            "expression": [
              "VAR PrecioAA = CALCULATE ( [Precio Promedio USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )",
              "RETURN",
              "    ( [Precio Promedio USD] - PrecioAA ) * [Unidades]"
            ],
            "formatString": "#,0",
            "displayFolder": "03 · Puente Precio-Volumen-Mix"
          },
          {
            "name": "Efecto Mix USD",
            "expression": [
              "[Var USD vs AA] - [Efecto Volumen USD] - [Efecto Precio USD]"
            ],
            "formatString": "#,0",
            "description": "El mix es el residuo: lo que la variación total tiene y que volumen y precio a nivel agregado no explican. Se calcula como residuo a propósito — así el puente cierra por construcción y no hay que \"ajustar\" nada.",
            "displayFolder": "03 · Puente Precio-Volumen-Mix"
          },
          {
            "name": "Control Cierre del Puente",
            "expression": [
              "VAR Suma = [Efecto Volumen USD] + [Efecto Precio USD] + [Efecto Mix USD]",
              "VAR Dif  = ABS ( Suma - [Var USD vs AA] )",
              "RETURN",
              "    IF ( Dif < 0.01, \"🟢 El puente cierra\", \"🔴 Descuadre de \" & FORMAT ( Dif, \"#,0.00\" ) )"
            ],
            "formatString": "#,0.00",
            "description": "Control de cierre. Si esta medida no da cero, el puente está mal y hay que decirlo, no maquillarlo.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "SKU que explican el 80%",
            "expression": [
              "VAR TablaSKU =",
              "    ADDCOLUMNS (",
              "        VALUES ( v_dim_producto[SKU] ),",
              "        \"@venta\", [Ventas Netas USD]",
              "    )",
              "VAR Total = SUMX ( TablaSKU, [@venta] )",
              "VAR ConAcumulado =",
              "    ADDCOLUMNS (",
              "        TablaSKU,",
              "        \"@acum\",",
              "            VAR VentaActual = [@venta]",
              "            RETURN",
              "                SUMX ( FILTER ( TablaSKU, [@venta] >= VentaActual ), [@venta] )",
              "    )",
              "RETURN",
              "    COUNTROWS ( FILTER ( ConAcumulado, DIVIDE ( [@acum], Total ) <= 0.80 ) ) + 1"
            ],
            "formatString": "0.0%",
            "description": "------------------------------------------------------------------------- CONCENTRACIÓN Y MIX DE PORTAFOLIO ------------------------------------------------------------------------- Regla de Pareto sobre el portafolio: cuántos SKU explican el 80% de la venta. En farma la concentración suele ser brutal, y saber el número exacto cambia la conversación sobre dónde poner la fuerza de ventas.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "% del Total Visible",
            "expression": [
              "DIVIDE (",
              "    [Ventas Netas USD],",
              "    CALCULATE ( [Ventas Netas USD], ALLSELECTED ( v_dim_producto ) )",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Participación del elemento en el total visible. ALLSELECTED —y no ALL— para que el porcentaje se calcule sobre lo que el usuario seleccionó en los slicers, no sobre la base entera. Es la diferencia entre \"20% del portafolio\" y \"20% de lo que estoy mirando\".",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Share de la Filial %",
            "expression": [
              "DIVIDE (",
              "    [Ventas Netas USD],",
              "    CALCULATE ( [Ventas Netas USD], ALLEXCEPT ( v_dim_filial, v_dim_filial[Filial] ) )",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Share de la filial dentro del total corporativo, INMUNE al filtro de producto. ALLEXCEPT conserva la filial y quita el resto: así el share por filial no se rompe cuando el usuario filtra una clase terapéutica. Sin este cuidado, el comercial ve un número que no cuadra y deja de confiar en el tablero — y con razón.",
            "displayFolder": "02 · Mercado y sell-out"
          },
          {
            "name": "Margen Bruto USD AA",
            "expression": [
              "CALCULATE ( [Margen Bruto USD], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- RENTABILIDAD -------------------------------------------------------------------------",
            "displayFolder": "01 · Tiempo"
          },
          {
            "name": "Var Margen pp",
            "expression": [
              "( [Margen Bruto %] - DIVIDE ( [Margen Bruto USD AA], [Ventas Netas USD AA] ) ) * 100"
            ],
            "formatString": "#,0.0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Margen Neto de Devoluciones USD",
            "expression": [
              "[Margen Bruto USD] - SUM ( v_fact_ventas[Importe devuelto USD] )"
            ],
            "formatString": "#,0",
            "description": "Margen neto de devoluciones: el margen que efectivamente queda después de que el canal devuelve. Es el número que importa y casi nunca se reporta.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Margen Neto de Devoluciones %",
            "expression": [
              "DIVIDE ( [Margen Neto de Devoluciones USD], [Ventas Netas USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Ofertas Emitidas",
            "expression": [
              "SUM ( v_fact_ofertas[Ofertas] )"
            ],
            "formatString": "#,0",
            "description": "========================================================================= FARMA DEMO — Biblioteca DAX · 02 · TABLERO OFERTAS  Pregunta que responde: \"¿Cuánto nos cuesta la política comercial, cuánto trae de vuelta, y dónde conviene poner el próximo peso de descuento?\"  El tablero cruza tres capas: 1. lo que PASÓ        — ofertas emitidas, aceptadas, inversión, retorno 2. lo que VA A PASAR  — proyección de inversión del modelo del paso 4 3. lo que HABRÍA que hacer — recomendación del motor de IA del paso 5  Esa tercera capa es la que convierte el tablero en una herramienta de decisión en vez de un reporte de resultados. ========================================================================= ------------------------------------------------------------------------- ACTIVIDAD DE CAMPAÑA -------------------------------------------------------------------------",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Ofertas Aceptadas",
            "expression": [
              "SUM ( v_fact_ofertas[Aceptada] )"
            ],
            "formatString": "#,0",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Tasa de Aceptación %",
            "expression": [
              "DIVIDE ( [Ofertas Aceptadas], [Ofertas Emitidas] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Tasa de Aceptación por Valor %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Valor Ofertado USD], v_fact_ofertas[Aceptada] = 1 ),",
              "    [Valor Ofertado USD]",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Ponderado por valor, no por conteo. Que se acepte el 60% de las ofertas no dice nada si el 40% rechazado concentra todo el volumen.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Valor Ofertado USD",
            "expression": [
              "SUMX (",
              "    v_fact_ofertas,",
              "    v_fact_ofertas[Unidades ofertadas] * RELATED ( v_dim_producto[Precio de lista USD] )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Inversión Comercial USD",
            "expression": [
              "SUMX (",
              "    FILTER ( v_fact_ofertas, v_fact_ofertas[Aceptada] = 1 ),",
              "    v_fact_ofertas[Unidades ofertadas]",
              "        * RELATED ( v_dim_producto[Precio de lista USD] )",
              "        * v_fact_ofertas[Descuento %]",
              ")"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- COSTO DE LA POLÍTICA COMERCIAL  \"Inversión comercial\" y no \"descuento otorgado\" a propósito: el nombre obliga a preguntarse cuál es el retorno. Un descuento sin retorno medido no es una inversión, es una resignación de margen. -------------------------------------------------------------------------",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Inversión Comercial Ajustada USD",
            "expression": [
              "SUMX (",
              "    FILTER ( v_fact_ofertas, v_fact_ofertas[Aceptada] = 1 ),",
              "    v_fact_ofertas[Unidades ofertadas]",
              "        * RELATED ( v_dim_producto[Precio de lista USD] )",
              "        * v_fact_ofertas[Descuento %]",
              "        * RELATED ( v_dim_tipo_oferta[Costo relativo] )",
              ")"
            ],
            "formatString": "#,0",
            "description": "Costo REAL de la oferta según su tipo. Una bonificación en producto no cuesta el precio de venta: cuesta el costo de fabricación. Tratar todas las ofertas igual sobreestima el costo de las bonificaciones ~30% y hace que el negocio elija mal el instrumento.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Descuento Medio Ponderado %",
            "expression": [
              "DIVIDE ( [Inversión Comercial USD], [Valor Ofertado USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Inversión sobre Ventas %",
            "expression": [
              "DIVIDE ( [Inversión Comercial USD], [Ventas Netas USD] )"
            ],
            "formatString": "0.0%",
            "description": "Inversión como porcentaje de la venta neta: el ratio que se lleva al comité. Una inversión que crece más rápido que la venta es una alarma, aunque el volumen esté subiendo.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Ventas con Oferta USD",
            "expression": [
              "CALCULATE (",
              "    [Ventas Netas USD],",
              "    v_dim_tipo_oferta[Código] <> \"SIN\"",
              ")"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- RETORNO ------------------------------------------------------------------------- Ventas asociadas a una oferta: solo las líneas con tipo de oferta distinto de \"Sin oferta\".",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Ventas sin Oferta USD",
            "expression": [
              "CALCULATE ( [Ventas Netas USD], v_dim_tipo_oferta[Código] = \"SIN\" )"
            ],
            "formatString": "#,0",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "% de Ventas con Oferta",
            "expression": [
              "DIVIDE ( [Ventas con Oferta USD], [Ventas Netas USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Margen de Ventas con Oferta USD",
            "expression": [
              "CALCULATE ( [Margen Bruto USD], v_dim_tipo_oferta[Código] <> \"SIN\" )"
            ],
            "formatString": "#,0",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "ROI de Ofertas",
            "expression": [
              "DIVIDE (",
              "    [Margen de Ventas con Oferta USD] - [Inversión Comercial Ajustada USD],",
              "    [Inversión Comercial Ajustada USD]",
              ")"
            ],
            "formatString": "0.0%",
            "description": "ROI de la política comercial. Se compara contra 0, no contra 1: acá el numerador ya es margen NETO de la inversión.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Nota Metodológica ROI",
            "expression": [
              "\"ROI comparativo, no causal: incluye ventas que podrían haber ocurrido sin oferta. Para medir impacto incremental hace falta un grupo de control.\""
            ],
            "description": "Advertencia honesta: este ROI NO es causal. Parte de la venta con oferta se habría hecho igual sin descuento — eso es canibalización, y sin un grupo de control no se puede separar. Se muestra como referencia comparativa entre filiales y tipos de oferta, no como medida de impacto incremental.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Semáforo de ROI",
            "expression": [
              "VAR R = [ROI de Ofertas]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( R ), BLANK (),",
              "        R >= 3, \"🟢 Alto\",",
              "        R >= 1, \"🟡 Aceptable\",",
              "        \"🔴 La oferta no se paga\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Margen por USD Invertido",
            "expression": [
              "DIVIDE ( [Margen de Ventas con Oferta USD], [Inversión Comercial Ajustada USD] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- EFICIENCIA POR INSTRUMENTO Y POR SEGMENTO ------------------------------------------------------------------------- Margen generado por cada dólar invertido en descuento. Es la métrica que permite comparar instrumentos distintos (descuento directo vs bonificación vs rebate) en la misma unidad.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Ranking de Eficiencia",
            "expression": [
              "RANKX (",
              "    ALLSELECTED ( v_dim_tipo_oferta[Tipo de oferta] ),",
              "    [Margen por USD Invertido],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "#,0.00",
            "description": "Ranking de eficiencia dentro del contexto visible.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Inversión en Clientes A %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Inversión Comercial USD], v_dim_cliente[Segmento] = \"A\" ),",
              "    CALCULATE ( [Inversión Comercial USD], REMOVEFILTERS ( v_dim_cliente[Segmento] ) )",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Cuánta inversión se concentra en los clientes que MENOS la necesitan. Un cliente segmento A que compraría igual y recibe el descuento más alto es inversión mal asignada — y es el hallazgo más frecuente al abrir por primera vez un tablero de ofertas.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Inversión Proyectada USD",
            "expression": [
              "SUM ( v_forecast_ofertas[Inversión proyectada USD] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- CAPA PREDICTIVA — proyección del modelo del paso 4 -------------------------------------------------------------------------",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Desvío del Forecast %",
            "expression": [
              "DIVIDE (",
              "    [Inversión Comercial USD] - [Inversión Proyectada USD],",
              "    [Inversión Proyectada USD]",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Precisión del Forecast %",
            "expression": [
              "VAR Holdout = FILTER ( v_forecast_ofertas, v_forecast_ofertas[Es holdout] = 1 )",
              "VAR Error   = SUMX ( Holdout, ABS ( v_forecast_ofertas[Inversión USD] - v_forecast_ofertas[Inversión proyectada USD] ) )",
              "VAR Real    = SUMX ( Holdout, v_forecast_ofertas[Inversión USD] )",
              "RETURN",
              "    1 - DIVIDE ( Error, Real )"
            ],
            "formatString": "0.0%",
            "description": "Precisión del forecast expresada como 1 - WMAPE, calculada SOLO sobre el holdout. Mostrar la precisión in-sample sería mentir con estadística correcta: el modelo siempre acierta donde entrenó.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Descuento Recomendado %",
            "expression": [
              "AVERAGE ( v_fact_recomendaciones[Descuento recomendado] )"
            ],
            "formatString": "0.0%",
            "description": "------------------------------------------------------------------------- CAPA PRESCRIPTIVA — motor de IA del paso 5 Es lo que hace que el tablero termine en una acción y no en un gráfico. -------------------------------------------------------------------------",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Ganancia Estimada USD",
            "expression": [
              "SUM ( v_fact_recomendaciones[Ganancia vs no ofertar USD] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Stock Rescatado USD",
            "expression": [
              "SUM ( v_fact_recomendaciones[Valor de stock rescatado USD] )"
            ],
            "formatString": "#,0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Recomendaciones Activas",
            "expression": [
              "COUNTROWS ( v_fact_recomendaciones )"
            ],
            "formatString": "#,0",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Brecha vs Descuento Actual pp",
            "expression": [
              "( [Descuento Recomendado %] - [Descuento Medio Ponderado %] ) * 100"
            ],
            "formatString": "#,0.0",
            "description": "Brecha entre lo que el motor recomienda y lo que la filial está haciendo. Es el visual que dispara la conversación: \"acá estás dando 8 puntos más de descuento de los que hacen falta\".",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Recomendaciones que Requieren Test",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( v_fact_recomendaciones ),",
              "    v_fact_recomendaciones[Confianza de la recomendación] = \"Requiere test controlado\"",
              ")"
            ],
            "formatString": "#,0",
            "description": "El motor nunca extrapola fuera del rango de descuentos con evidencia histórica. Cuando el óptimo cae en ese borde, lo declara: la acción correcta no es aplicarlo a toda la cartera, es testearlo en un subconjunto.",
            "displayFolder": "05 · Ofertas e IA"
          },
          {
            "name": "Justificativo Seleccionado",
            "expression": [
              "IF (",
              "    HASONEVALUE ( v_fact_recomendaciones[Justificativo] ),",
              "    SELECTEDVALUE ( v_fact_recomendaciones[Justificativo] ),",
              "    \"Seleccioná una recomendación para ver por qué el motor la propone.\"",
              ")"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Titular de Recomendaciones",
            "expression": [
              "VAR N        = [Recomendaciones Activas]",
              "VAR Ganancia = [Ganancia Estimada USD]",
              "VAR Rescate  = [Stock Rescatado USD]",
              "VAR Test     = [Recomendaciones que Requieren Test]",
              "RETURN",
              "    IF (",
              "        N = 0,",
              "        \"No hay recomendaciones para el contexto seleccionado.\",",
              "        FORMAT ( N, \"#,0\" ) & \" recomendaciones · \" &",
              "        FORMAT ( Ganancia, \"#,0\" ) & \" USD de margen incremental estimado · \" &",
              "        FORMAT ( Rescate, \"#,0\" ) & \" USD de stock crítico rescatado\" &",
              "        IF ( Test > 0, \" · \" & Test & \" requieren test controlado antes de generalizar\", \"\" )",
              "    )"
            ],
            "description": "Resumen ejecutivo autogenerado para el encabezado del tablero.",
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Líneas Despachadas",
            "expression": [
              "SUM ( v_fact_ventas[Líneas] )"
            ],
            "formatString": "#,0",
            "description": "========================================================================= FARMA DEMO — Biblioteca DAX · 03 · TABLERO LOGÍSTICA  Pregunta que responde: \"¿Estamos entregando bien, cuánto nos cuesta lo que vuelve, y qué pedidos de los que están por salir van a volver?\"  Es el único de los tres tableros con una capa operativa en tiempo de decisión: el scoring de riesgo se mira ANTES de despachar, no después de que la devolución ya ocurrió. ========================================================================= ------------------------------------------------------------------------- NIVEL DE SERVICIO  Todos los promedios de esta sección son PONDERADOS. El modelo expone el numerador (lead time × línea) y no el promedio ya calculado, justamente para poder ponderar bien en cualquier nivel de agregación. Promediar promedios es el error silencioso más caro de un tablero logístico: da un número plausible y equivocado. -------------------------------------------------------------------------",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "OTIF %",
            "expression": [
              "DIVIDE ( SUM ( v_fact_ventas[Líneas OTIF] ), [Líneas Despachadas] )"
            ],
            "formatString": "0.0%",
            "description": "OTIF = On Time In Full. El estándar de servicio de la industria: entregado a tiempo Y completo. Las dos condiciones a la vez — de ahí que se mida sobre líneas y no sobre pedidos.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Fill Rate %",
            "expression": [
              "DIVIDE ( SUM ( v_fact_ventas[Líneas completas] ), [Líneas Despachadas] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Entregas a Tiempo %",
            "expression": [
              "DIVIDE (",
              "    SUM ( v_fact_ventas[Líneas OTIF] ),",
              "    SUM ( v_fact_ventas[Líneas completas] )",
              ")"
            ],
            "formatString": "0.0%",
            "description": "Puntualidad aislada del completado: separar las dos causas permite saber si el problema es del transportista (tiempo) o del depósito (completitud).",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Lead Time Promedio",
            "expression": [
              "DIVIDE ( SUM ( v_fact_ventas[Lead time x línea] ), [Líneas Despachadas] )"
            ],
            "formatString": "#,0.0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "SLA Objetivo",
            "expression": [
              "AVERAGE ( v_dim_filial[SLA entrega (días)] )"
            ],
            "formatString": "#,0.0",
            "displayFolder": "04 · Objetivo"
          },
          {
            "name": "Exceso sobre SLA",
            "expression": [
              "[Lead Time Promedio] - [SLA Objetivo]"
            ],
            "formatString": "#,0.0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "OTIF % AA",
            "expression": [
              "CALCULATE ( [OTIF %], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Var OTIF pp",
            "expression": [
              "( [OTIF %] - [OTIF % AA] ) * 100"
            ],
            "formatString": "#,0.0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Semáforo OTIF",
            "expression": [
              "VAR O = [OTIF %]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( O ), BLANK (),",
              "        O >= 0.95, \"🟢 En objetivo\",",
              "        O >= 0.88, \"🟡 Por debajo del objetivo\",",
              "        \"🔴 Nivel de servicio crítico\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Unidades Devueltas",
            "expression": [
              "SUM ( v_fact_devoluciones[Unidades devueltas] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- DEVOLUCIONES -------------------------------------------------------------------------",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Importe Devuelto USD",
            "expression": [
              "SUM ( v_fact_devoluciones[Importe devuelto USD] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Tasa de Devolución Valor %",
            "expression": [
              "DIVIDE ( [Importe Devuelto USD], [Ventas Brutas USD] )"
            ],
            "formatString": "0.0%",
            "description": "Dos tasas, no una. La tasa en valor es la que impacta el resultado; la tasa en unidades es la que dimensiona el problema operativo. Cuando divergen mucho, se está devolviendo producto caro (o barato) de forma desproporcionada, y eso es en sí mismo un hallazgo.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Tasa de Devolución Unidades %",
            "expression": [
              "DIVIDE ( [Unidades Devueltas], CALCULATE ( [Unidades], v_fact_ventas[Tipo documento] = \"FC\" ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Tasa de Devolución Valor % AA",
            "expression": [
              "CALCULATE ( [Tasa de Devolución Valor %], SAMEPERIODLASTYEAR ( v_dim_calendario[Fecha] ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Var Tasa Devolución pp",
            "expression": [
              "( [Tasa de Devolución Valor %] - [Tasa de Devolución Valor % AA] ) * 100"
            ],
            "formatString": "#,0.0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Devoluciones Evitables USD",
            "expression": [
              "CALCULATE ( [Importe Devuelto USD], v_dim_motivo_devolucion[Evitabilidad] = \"Evitable\" )"
            ],
            "formatString": "#,0",
            "description": "Separar lo evitable de lo que pasa y ya. Un 6% de devoluciones donde el 80% es evitable es un problema de gestión; el mismo 6% mayormente no evitable es una característica del negocio. Actuar igual en los dos casos es desperdiciar esfuerzo.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "% Devoluciones Evitables",
            "expression": [
              "DIVIDE ( [Devoluciones Evitables USD], [Importe Devuelto USD] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Margen Perdido por Devoluciones USD",
            "expression": [
              "[Importe Devuelto USD] * DIVIDE ( [Margen Bruto USD], [Ventas Netas USD] )"
            ],
            "formatString": "#,0",
            "description": "Impacto real en el resultado: lo devuelto valuado a margen perdido, no a precio de venta. El costo de una devolución no es solo el margen que se pierde — también hay logística inversa y, muchas veces, destrucción de producto. Acá se reporta la parte medible con el dato disponible.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Motivo Principal de Devolución",
            "expression": [
              "VAR TablaMotivos =",
              "    ADDCOLUMNS (",
              "        VALUES ( v_dim_motivo_devolucion[Motivo de devolución] ),",
              "        \"@importe\", [Importe Devuelto USD]",
              "    )",
              "VAR Top = TOPN ( 1, TablaMotivos, [@importe], DESC )",
              "RETURN",
              "    CONCATENATEX ( Top, v_dim_motivo_devolucion[Motivo de devolución] )",
              "        & \" (\" & FORMAT ( DIVIDE ( MAXX ( Top, [@importe] ), [Importe Devuelto USD] ), \"0%\" ) & \" del total)\""
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Stock Unidades",
            "expression": [
              "SUM ( v_fact_stock[Stock unidades] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- STOCK Y VENCIMIENTOS -------------------------------------------------------------------------",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Valor de Stock USD",
            "expression": [
              "SUM ( v_fact_stock[Valor de stock USD] )"
            ],
            "formatString": "#,0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Días de Cobertura",
            "expression": [
              "DIVIDE ( SUM ( v_fact_stock[Cobertura x stock] ), [Stock Unidades] )"
            ],
            "formatString": "#,0.0",
            "description": "Cobertura ponderada por stock. Igual que el lead time: el modelo trae el numerador para poder ponderar en cualquier corte.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Estado de Cobertura",
            "expression": [
              "VAR D = [Días de Cobertura]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( D ), BLANK (),",
              "        D < 30,  \"🔴 Riesgo de quiebre\",",
              "        D <= 90, \"🟢 En rango\",",
              "        D <= 150, \"🟡 Sobrestock — candidato a oferta\",",
              "        \"🔴 Sobrestock severo\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Unidades por Vencer",
            "expression": [
              "SUM ( v_fact_stock[Unidades por vencer 180d] )"
            ],
            "formatString": "#,0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Valor en Riesgo de Vencimiento USD",
            "expression": [
              "SUMX (",
              "    v_fact_stock,",
              "    v_fact_stock[Unidades por vencer 180d]",
              "        * RELATED ( v_dim_producto[Costo estándar USD] )",
              ")"
            ],
            "formatString": "#,0",
            "description": "Valor en riesgo de vencimiento, a costo. Es una pérdida potencial cierta si no se mueve el producto — y es exactamente el input que toma el motor de IA del paso 5 para priorizar qué ofertar.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "% de Stock por Vencer",
            "expression": [
              "DIVIDE ( [Unidades por Vencer], [Stock Unidades] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Importe en Riesgo USD",
            "expression": [
              "SUM ( v_fact_scoring_devoluciones[Importe en riesgo USD] )"
            ],
            "formatString": "#,0",
            "description": "------------------------------------------------------------------------- CAPA PREDICTIVA — scoring del modelo del paso 3  Acá está el salto de un tablero descriptivo a uno operativo: el riesgo se consulta ANTES del despacho. Un modelo que solo explica devoluciones que ya ocurrieron es un informe; uno que las anticipa es una herramienta. -------------------------------------------------------------------------",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Pedidos en Riesgo Crítico",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( v_fact_scoring_devoluciones ),",
              "    v_fact_scoring_devoluciones[Banda de riesgo] = \"Crítico\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Probabilidad Media de Devolución",
            "expression": [
              "AVERAGE ( v_fact_scoring_devoluciones[Probabilidad de devolución] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Captura en el Top 10% de Riesgo",
            "expression": [
              "VAR N = COUNTROWS ( v_fact_scoring_devoluciones )",
              "VAR Corte =",
              "    PERCENTILEX.INC (",
              "        v_fact_scoring_devoluciones,",
              "        v_fact_scoring_devoluciones[Probabilidad de devolución],",
              "        0.90",
              "    )",
              "VAR DevolucionesEnTop =",
              "    CALCULATE (",
              "        SUM ( v_fact_scoring_devoluciones[Devuelta real] ),",
              "        v_fact_scoring_devoluciones[Probabilidad de devolución] >= Corte",
              "    )",
              "VAR DevolucionesTotales = SUM ( v_fact_scoring_devoluciones[Devuelta real] )",
              "RETURN",
              "    DIVIDE ( DevolucionesEnTop, DevolucionesTotales )"
            ],
            "formatString": "0.0%",
            "description": "Traducción operativa del modelo. No se comunica \"AUC 0,82\" a un gerente de logística: se comunica cuántas devoluciones evita revisando el 10% de los pedidos. Es el mismo modelo, dicho en el idioma de quien decide.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Lectura del Modelo de Riesgo",
            "expression": [
              "VAR Captura = [Captura en el Top 10% de Riesgo]",
              "VAR Monto   = [Importe en Riesgo USD]",
              "RETURN",
              "    \"Revisando el 10% de pedidos con mayor riesgo se anticipan el \"",
              "        & FORMAT ( Captura, \"0%\" )",
              "        & \" de las devoluciones. Exposición estimada del período: USD \"",
              "        & FORMAT ( Monto, \"#,0\" ) & \".\""
            ],
            "displayFolder": "00 · Contexto y gobierno"
          },
          {
            "name": "Tasa Devolución Proyectada %",
            "expression": [
              "AVERAGE ( v_forecast_devoluciones[Tasa dev proyectada] )"
            ],
            "formatString": "0.0%",
            "description": "------------------------------------------------------------------------- CAPA PREDICTIVA — proyección mensual del paso 3 -------------------------------------------------------------------------",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Importe Devuelto Proyectado USD",
            "expression": [
              "SUM ( v_forecast_devoluciones[Importe dev proyectado] )"
            ],
            "formatString": "#,0",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Provisión Sugerida USD",
            "expression": [
              "[Importe Devuelto Proyectado USD]"
            ],
            "formatString": "#,0",
            "description": "Provisión sugerida para el mes siguiente, sobre la proyección del modelo. Que la contabilidad y el tablero salgan del MISMO número es, en sí mismo, medio trabajo de Data Steward resuelto.",
            "displayFolder": "01 · Ventas y margen"
          },
          {
            "name": "Contribución a Devoluciones %",
            "expression": [
              "DIVIDE (",
              "    [Importe Devuelto USD],",
              "    CALCULATE ( [Importe Devuelto USD], REMOVEFILTERS ( v_dim_transportista ) )",
              ")"
            ],
            "formatString": "0.0%",
            "description": "------------------------------------------------------------------------- PERFORMANCE DE TRANSPORTISTAS ------------------------------------------------------------------------- Contribución de cada transportista al problema total de devoluciones. Ordenar por tasa sola premia al que mueve tres pedidos; hay que mirar tasa Y peso a la vez.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Riesgo Frío sin Control USD",
            "expression": [
              "CALCULATE (",
              "    [Ventas Netas USD],",
              "    v_dim_producto[Condición de conservación] = \"Cadena de frío\",",
              "    v_dim_transportista[Control de temperatura] = \"Sin control de frío\"",
              ")"
            ],
            "formatString": "#,0",
            "description": "El cruce que explica buena parte de las devoluciones del negocio: producto que requiere cadena de frío despachado por un operador que no la controla. Es un hallazgo accionable de inmediato — se cambia la asignación y listo.",
            "displayFolder": "06 · Logística y riesgo"
          },
          {
            "name": "Alerta de Cadena de Frío",
            "expression": [
              "VAR Expuesto = [Riesgo Frío sin Control USD]",
              "RETURN",
              "    IF (",
              "        Expuesto > 0,",
              "        \"🔴 USD \" & FORMAT ( Expuesto, \"#,0\" )",
              "            & \" despachados en cadena de frío por operadores sin control de temperatura\",",
              "        \"🟢 Todo el producto de frío viaja con control de temperatura\"",
              "    )"
            ],
            "displayFolder": "00 · Contexto y gobierno"
          }
        ]
      }
    ],
